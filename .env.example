# Supabase Cloud Credentials (Optional for local testing, required for cloud sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Supabase Realtime (Vite public env)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NASA DONKI & Cron Security
NASA_API_KEY=DEMO_KEY
CRON_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
GEMINI_CACHE_TTL_SECONDS=90
GEMINI_TTS_ENABLED=false
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICE=en-US-AvaNeural
TTS_PREFER_LOCAL=false

# Server settings
PORT=8000
ENVIRONMENT=development
